# Local model assets. Activate your Megatron environment before running AutoSFT.
# The HF directory contains the base weights, config and tokenizer together.
AUTO_SFT_SFT_TOKENIZER_MODEL=/path/to/Qwen3-1.7B-Base
# Import that HF model once into Megatron's checkpoint format.
AUTO_SFT_SFT_BASE_CKPT=/path/to/megatron-base-checkpoint

# Optional local Megatron checkout. Leave unset to fetch the pinned public
# NVIDIA checkout into third_party/megatron. Set this when Megatron was copied
# from another machine or the host cannot reach GitHub.
# AUTO_SFT_MEGATRON_DIR=/path/to/Megatron-LM-23e00ed0963c35382dfe8a5a94fb3cda4d21e133

# Optional stage-specific interpreters. Keep training/conversion on a matching
# PyTorch + CUDA stack; use a separate evaluation environment if vLLM needs a
# different PyTorch ABI.
# AUTO_SFT_TRAIN_PYTHON=/path/to/train-venv/bin/python
# AUTO_SFT_CONVERT_PYTHON=/path/to/train-venv/bin/python
# AUTO_SFT_EVAL_PYTHON=/path/to/eval-venv/bin/python

# Data-processing model called by the agents for rewriting and quality checks.
# Research-agent authentication is configured in Codex CLI.
AUTO_SFT_LLM_BASE_URL=https://provider.example/v1
AUTO_SFT_LLM_MODEL=your-model-id
AUTO_SFT_LLM_API_KEY=replace-me

# Synthesis uses the same provider as data processing (AUTO_SFT_LLM_* above).

# Any OpenAI-compatible relay can be used. The endpoint may also include
# /chat/completions; AutoSFT normalizes both forms.
